{
  "description": "docdd: docdd のプロジェクトで、取り消しにくい git 操作（git add -A・git commit --amend・強制 push など）を止め、rm -r／rm -f の前に確認を出す",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-bash.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-bash.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
